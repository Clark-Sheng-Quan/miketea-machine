NODE_ENV=development
PORT=3000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=miketea_machine
DB_USER=postgres
DB_PASSWORD=your_password_here

# POS System API (Real API endpoint)
POS_API_BASE=https://dev.vend88.com
POS_ACCOUNT=your_email@example.com
POS_PASSWORD=your_password_here
POS_BUSINESS_ID=your_business_id_here

# QR Code Settings
QR_PROTOCOL_VERSION=1.0
QR_DEFAULT_TEMPLATE={serial}|{billNo}|{barcode}|{flavors}|{sku}

# Sync Settings
FLAVOR_SYNC_INTERVAL=3600000
FLAVOR_SYNC_ENABLED=true

# Web Admin
ADMIN_PORT=3001
ADMIN_API_URL=http://localhost:3000/api
